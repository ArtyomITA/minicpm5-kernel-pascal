+// KMC (MiniCPM5 on Pascal): run the Q8_0 MUL_MATs that share this node's input in one launch with one quantization of
+// the input (ggml_cuda_kmc_mul_mat_vec_q8_0_multi, bit-identical to separate MMVQ launches). In MiniCPM5/LFM2.5 this
+// catches FFN gate + up at 2-8 columns (speculative verify), where the GLU fusion of ggml does not apply; attention
+// Q/K/V are usually placed by the allocator in each other's memory and are then left alone by the overlap check.
+// Later nodes are recorded in `done` and skipped when the loop reaches them. Valve: GGML_CUDA_DISABLE_KMC_QKV=1.
+static bool ggml_cuda_kmc_try_qkv(ggml_backend_cuda_context * cuda_ctx, const ggml_cgraph * cgraph, const int i,
+                                  std::vector<const ggml_tensor *> & done) {
+    static const bool enabled = getenv("GGML_CUDA_DISABLE_KMC_QKV") == nullptr && getenv("GGML_CUDA_GRAPH_OPT") == nullptr;
+    const ggml_tensor * node = cgraph->nodes[i];
+    if (!enabled || node->op != GGML_OP_MUL_MAT) {
+        return false;
+    }
+    const int cc = ggml_cuda_info().devices[cuda_ctx->device].cc;
+    if (!GGML_CUDA_CC_IS_NVIDIA(cc) || cc >= GGML_CUDA_CC_VOLTA) {
+        return false; // measured and verified on Pascal only
+    }
+    const auto candidate = [&](const ggml_tensor * t) {
+        return t->op == GGML_OP_MUL_MAT && t->src[1] == node->src[1] && t->src[0]->type == GGML_TYPE_Q8_0 &&
+               t->src[1]->type == GGML_TYPE_F32 && t->type == GGML_TYPE_F32 && t->src[0]->ne[0] == node->src[0]->ne[0] &&
+               t->ne[1] == node->ne[1] && t->ne[1] <= MMVQ_MAX_BATCH_SIZE && (t->flags & GGML_TENSOR_FLAG_COMPUTE);
+    };
+    if (!candidate(node) || !ggml_cuda_should_use_mmvq(GGML_TYPE_Q8_0, cc, node->ne[1])) {
+        return false;
+    }
+    const auto overlap = [](const ggml_tensor * a, const ggml_tensor * b) {
+        const char * a0 = (const char *) a->data;
+        const char * b0 = (const char *) b->data;
+        return a0 < b0 + ggml_nbytes(b) && b0 < a0 + ggml_nbytes(a);
+    };
+    // A later projection E (original position pE) can be computed at position i only if no node in (i, pE) reads or
+    // writes memory that overlaps E, and E does not overlap the shared input or the projections already taken.
+    const ggml_tensor * mm[3] = { node, nullptr, nullptr };
+    int n = 1;
+    for (int pE = i + 1; pE < cgraph->n_nodes && pE <= i + 24 && n < 3; ++pE) {
+        const ggml_tensor * E = cgraph->nodes[pE];
+        if (!candidate(E)) {
+            continue;
+        }
+        const ggml_tensor * conflict = overlap(E, node->src[1]) ? node->src[1] : nullptr;
+        for (int k = 0; k < n && !conflict; ++k) {
+            conflict = overlap(E, mm[k]) ? mm[k] : nullptr;
+        }
+        for (int j = i + 1; j < pE && !conflict; ++j) {
+            const ggml_tensor * t = cgraph->nodes[j];
+            if (t == mm[1] || t == mm[2]) {
+                continue; // computed early as well, and not executed at j
+            }
+            if (t->data && overlap(E, t)) {
+                conflict = t;
+            }
+            for (int s = 0; s < GGML_MAX_SRC && !conflict; ++s) {
+                if (t->src[s] && t->src[s]->data && overlap(E, t->src[s])) {
+                    conflict = t->src[s];
+                }
+            }
+        }
+        if (conflict) {
+            continue;
+        }
+        mm[n++] = E;
+    }
+    if (n < 2) {
+        return false;
+    }
+
+    if (!ggml_cuda_kmc_mul_mat_vec_q8_0_multi(*cuda_ctx, mm, n)) {
+        return false;
+    }
+    for (int k = 1; k < n; ++k) {
+        done.push_back(mm[k]);
+    }
+    return true;
+}
