+// KMC (MiniCPM5 on Pascal): Q8_0, one column, K <= 256. The generic kernel gives each row a whole block but only its first
+// warp has work (4 threads per Q8_0 block, at most 8 blocks per row), so run one row per warp instead. Every row gets the
+// same per-thread partial sums and the same warp reduction; the generic kernel only adds exact zeros from its idle warps.
+static __global__ void __launch_bounds__(128, 1) kmc_mul_mat_vec_q8_0_rowwarp(
+        const void * __restrict__ vx, const void * __restrict__ vy, const float * __restrict__ x_bias,
+        float * __restrict__ dst, const int nrows, const int blocks_per_row_x, const int stride_row_x) {
+    constexpr int qi  = ggml_cuda_type_traits<GGML_TYPE_Q8_0>::qi;
+    constexpr int vdr = get_vdr_mmvq(GGML_TYPE_Q8_0);
+    constexpr int blocks_per_iter = vdr * 4*WARP_SIZE / qi; // stride of the generic kernel (4 warps)
+
+    const int row = 4*blockIdx.x + threadIdx.y;
+    if (row >= nrows) {
+        return;
+    }
+    const block_q8_1 * y = (const block_q8_1 *) vy;
+
+    float tmp = 0.0f;
+    for (int kbx = threadIdx.x / (qi/vdr); kbx < blocks_per_row_x; kbx += blocks_per_iter) {
+        const int kqs = vdr * (threadIdx.x % (qi/vdr));
+        tmp += vec_dot_q8_0_q8_1(vx, &y[kbx], row*stride_row_x + kbx, kqs);
+    }
+    tmp = warp_reduce_sum<WARP_SIZE>(tmp);
+    if (threadIdx.x == 0) {
+        dst[row] = x_bias ? tmp + x_bias[row] : tmp;
+    }
+}
+
+// KMC (MiniCPM5 on Pascal): dense Q8_0 MMVQ with strength-reduced addressing. The profile showed the generic kernel
+// issue-bound at 5-8 columns (~half of the loop is 32-bit index arithmetic, emulated with XMAD on Pascal). Thread
+// mapping (same nwarps as calc_nwarps), per-thread partial sums, the order of additions, the shared-memory combination
+// of the warps and the warp reduction are those of mul_mat_vec_q<Q8_0, ncols_dst, false>, so every output is
+// bit-identical; only pointer arithmetic and the number of rows per block differ.
+// Up to 3 matrices with the same K and the same input: blocks are assigned to matrices in order.
+struct kmc_q8_args {
+    const char * vx[3];
+    float      * dst[3];
+    int          nrows[3];          // rows of each matrix (multiple of rows_per_block, 0 if unused)
+    int          stride_col_dst[3];
+};
+
+template <int ncols_dst, int rows_per_block>
+__launch_bounds__(calc_nwarps(GGML_TYPE_Q8_0, ncols_dst, MMVQ_PARAMETERS_GENERIC)*WARP_SIZE, 1)
+static __global__ void kmc_mmvq_q8_0(
+        const kmc_q8_args args, const char * __restrict__ vy,
+        const int blocks_per_row_x, const int stride_row_bytes, const int stride_col_y_bytes) {
+    constexpr int nwarps          = calc_nwarps(GGML_TYPE_Q8_0, ncols_dst, MMVQ_PARAMETERS_GENERIC);
+    constexpr int vdr             = VDR_Q8_0_Q8_1_MMVQ;
+    constexpr int qi              = QI8_0;
+    constexpr int blocks_per_iter = vdr*nwarps*WARP_SIZE/qi;
+    static_assert(vdr == 2, "the x loads below assume 2 ints per thread");
+
+    const int tid  = WARP_SIZE*threadIdx.y + threadIdx.x;
+    int row0 = rows_per_block*blockIdx.x;
+    int m    = 0;
+    if (row0 >= args.nrows[0]) {
+        row0 -= args.nrows[0];
+        m = 1;
+        if (row0 >= args.nrows[1]) {
+            row0 -= args.nrows[1];
+            m = 2;
+        }
+    }
+    // select with branches: a runtime index into the parameter struct would go through local memory
+    const char * vx             = m == 0 ? args.vx[0]             : m == 1 ? args.vx[1]             : args.vx[2];
+    float      * dst            = m == 0 ? args.dst[0]            : m == 1 ? args.dst[1]            : args.dst[2];
+    const int    nrows          = m == 0 ? args.nrows[0]          : m == 1 ? args.nrows[1]          : args.nrows[2];
+    const int    stride_col_dst = m == 0 ? args.stride_col_dst[0] : m == 1 ? args.stride_col_dst[1] : args.stride_col_dst[2];
+    const int kbx0 = tid / (qi/vdr);
+    const int kqs  = vdr * (tid % (qi/vdr));
+
+    const char * x = vx + (int64_t) row0*stride_row_bytes + kbx0*(int) sizeof(block_q8_0);
+    const char * y = vy + kbx0*(int) sizeof(block_q8_1); // Q8_0 and Q8_1 blocks have the same 32 values
+
+    float tmp[ncols_dst][rows_per_block] = {{0.0f}};
+
+    for (int kbx = kbx0; kbx < blocks_per_row_x; kbx += blocks_per_iter) {
+#pragma unroll
+        for (int i = 0; i < rows_per_block; ++i) {
+            // The 8 quant bytes of this thread start 2 bytes into a word when the block index is even (34-byte
+            // blocks). Read the covering words through the read-only path and funnel-shift: same two ints as
+            // get_int_b2, 2-3 loads instead of 4 16-bit loads, and no read past the block.
+            const char * xb = x + i*stride_row_bytes;
+            const char * xq = xb + 2 + 4*kqs;
+            const int  * w  = (const int *) (xq - ((uintptr_t) xq & 2));
+            const int    sh = (int) ((uintptr_t) xq & 2) * 8;
+            const int    w0 = __ldg(w + 0);
+            const int    w1 = __ldg(w + 1);
+            const int    w2 = sh ? (int) __ldg((const unsigned short *) (w + 2)) : 0;
+            int v[vdr];
+            v[0] = __funnelshift_r(w0, w1, sh);
+            v[1] = __funnelshift_r(w1, w2, sh);
+            const float dx = __half2float(__ushort_as_half(__ldg((const unsigned short *) xb)));
+#pragma unroll
+            for (int j = 0; j < ncols_dst; ++j) {
+                const block_q8_1 * by = (const block_q8_1 *) (y + j*stride_col_y_bytes);
+                int u[vdr];
+#pragma unroll
+                for (int l = 0; l < vdr; ++l) {
+                    u[l] = get_int_b4(by->qs, kqs + l);
+                }
+                tmp[j][i] += vec_dot_q8_0_q8_1_impl<float, vdr>(v, u, dx, __low2half(by->ds));
+            }
+        }
+        x += blocks_per_iter*(int) sizeof(block_q8_0);
+        y += blocks_per_iter*(int) sizeof(block_q8_1);
+    }
+
+    __shared__ float tmp_shared[nwarps-1 > 0 ? nwarps-1 : 1][ncols_dst][rows_per_block][WARP_SIZE];
+    if (threadIdx.y > 0) {
+#pragma unroll
+        for (int j = 0; j < ncols_dst; ++j) {
+#pragma unroll
+            for (int i = 0; i < rows_per_block; ++i) {
+                tmp_shared[threadIdx.y-1][j][i][threadIdx.x] = tmp[j][i];
+            }
+        }
+    }
+    __syncthreads();
+    if (threadIdx.y > 0) {
+        return;
+    }
+
+    dst += row0;
+#pragma unroll
+    for (int j = 0; j < ncols_dst; ++j) {
+#pragma unroll
+        for (int i = 0; i < rows_per_block; ++i) {
+#pragma unroll
+            for (int l = 0; l < nwarps-1; ++l) {
+                tmp[j][i] += tmp_shared[l][j][i][threadIdx.x];
+            }
+            tmp[j][i] = warp_reduce_sum<WARP_SIZE>(tmp[j][i]);
+
+            if (threadIdx.x == i && (rows_per_block == 1 || row0 + i < nrows)) {
+                dst[j*stride_col_dst + i] = tmp[j][i];
+            }
+        }
+    }
+}
+
+template <int ncols_dst>
+static void kmc_mmvq_q8_0_launch(const kmc_q8_args & args, const void * vy, const int blocks_per_row_x, const int stride_row_x,
+        const int stride_col_y, const int rows_per_block, cudaStream_t stream) {
+    constexpr int nwarps = calc_nwarps(GGML_TYPE_Q8_0, ncols_dst, MMVQ_PARAMETERS_GENERIC);
+    const dim3 block_dims(WARP_SIZE, nwarps, 1);
+    const int nblocks            = (args.nrows[0] + args.nrows[1] + args.nrows[2]) / rows_per_block;
+    const int stride_row_bytes   = stride_row_x*(int) sizeof(block_q8_0);
+    const int stride_col_y_bytes = stride_col_y*(int) sizeof(block_q8_1);
+    const char * y = (const char *) vy;
+    if (rows_per_block == 4) {
+        kmc_mmvq_q8_0<ncols_dst, 4><<<nblocks, block_dims, 0, stream>>>(args, y, blocks_per_row_x, stride_row_bytes, stride_col_y_bytes);
+    } else if (rows_per_block == 2) {
+        kmc_mmvq_q8_0<ncols_dst, 2><<<nblocks, block_dims, 0, stream>>>(args, y, blocks_per_row_x, stride_row_bytes, stride_col_y_bytes);
+    } else {
+        kmc_mmvq_q8_0<ncols_dst, 1><<<nblocks, block_dims, 0, stream>>>(args, y, blocks_per_row_x, stride_row_bytes, stride_col_y_bytes);
+    }
+    CUDA_CHECK(cudaGetLastError());
+}
