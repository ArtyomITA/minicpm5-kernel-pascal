+// KMC (MiniCPM5 on Pascal): Q8_0 projections that share one input (e.g. FFN gate and up) in one launch of kmc_mmvq_q8_0
+// with one q8_1 quantization of the input. Every row is computed exactly as by separate launches (bit-identical).
+bool ggml_cuda_kmc_mul_mat_vec_q8_0_multi(ggml_backend_cuda_context & ctx, const ggml_tensor * const * mm, int n) {
+    GGML_ASSERT(n >= 2 && n <= 3);
+    const ggml_tensor * src1 = mm[0]->src[1];
+    const int64_t K    = mm[0]->src[0]->ne[0];
+    const int64_t ncol = mm[0]->ne[1];
+
+    const int device = ggml_cuda_get_device();
+    const int cc     = ggml_cuda_info().devices[device].cc;
+    if (get_device_table_id(cc) != MMVQ_PARAMETERS_GENERIC || ncol < 1 || ncol > MMVQ_MAX_BATCH_SIZE || K % QK8_0 != 0 ||
+            K / QK8_0 <= 8) {
+        return false;
+    }
+    const int rows = kmc_q8_rows((int) ncol, mm[0]->src[0]->ne[1]);
+
+    kmc_q8_args args{};
+    for (int k = 0; k < n; ++k) {
+        const ggml_tensor * src0 = mm[k]->src[0];
+        const ggml_tensor * dst  = mm[k];
+        if (src0->type != GGML_TYPE_Q8_0 || !ggml_is_contiguous(src0) || !ggml_is_contiguous(dst) ||
+                src0->ne[0] != K || src0->ne[2] != 1 || src0->ne[3] != 1 || dst->ne[1] != ncol ||
+                dst->ne[2] != 1 || dst->ne[3] != 1 || mm[k]->src[1] != src1 || src0->ne[1] % rows != 0 ||
+                ggml_backend_buffer_get_usage(src0->buffer) == GGML_BACKEND_BUFFER_USAGE_COMPUTE) {
+            return false;
+        }
+        args.vx[k]             = (const char *) src0->data;
+        args.dst[k]            = (float *) dst->data;
+        args.nrows[k]          = (int) src0->ne[1];
+        args.stride_col_dst[k] = (int) src0->ne[1];
+    }
+    if (src1->type != GGML_TYPE_F32 || src1->nb[0] != sizeof(float) || src1->ne[2] != 1 || src1->ne[3] != 1) {
+        return false;
+    }
+
+    cudaStream_t stream = ctx.stream();
+    const int64_t ne10_padded = GGML_PAD(K, MATRIX_ROW_PADDING);
+    ggml_cuda_pool_alloc<char> src1_q8_1(ctx.pool(), ncol * ne10_padded * sizeof(block_q8_1)/QK8_1);
+    quantize_row_q8_1_cuda((const float *) src1->data, nullptr, src1_q8_1.get(), GGML_TYPE_Q8_0, K,
+                           src1->nb[1] / sizeof(float), src1->nb[2] / sizeof(float), src1->nb[3] / sizeof(float),
+                           ne10_padded, ncol, 1, 1, stream);
+
+    kmc_mmvq_q8_0_switch(args, src1_q8_1.get(), (int) ncol, (int) (K / QK8_0), (int) (K / QK8_0),
+                         (int) (ne10_padded / QK8_1), rows, stream);
+    return true;
+}

