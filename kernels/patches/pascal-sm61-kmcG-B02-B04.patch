+static void kmc_mmvq_q8_0_switch(const kmc_q8_args & args, const void * vy, const int ncols_dst, const int blocks_per_row_x,
+        const int stride_row_x, const int stride_col_y, const int rows_per_block, cudaStream_t stream) {
+    switch (ncols_dst) {
+        case 1: kmc_mmvq_q8_0_launch<1>(args, vy, blocks_per_row_x, stride_row_x, stride_col_y, rows_per_block, stream); break;
+        case 2: kmc_mmvq_q8_0_launch<2>(args, vy, blocks_per_row_x, stride_row_x, stride_col_y, rows_per_block, stream); break;
+        case 3: kmc_mmvq_q8_0_launch<3>(args, vy, blocks_per_row_x, stride_row_x, stride_col_y, rows_per_block, stream); break;
+        case 4: kmc_mmvq_q8_0_launch<4>(args, vy, blocks_per_row_x, stride_row_x, stride_col_y, rows_per_block, stream); break;
+        case 5: kmc_mmvq_q8_0_launch<5>(args, vy, blocks_per_row_x, stride_row_x, stride_col_y, rows_per_block, stream); break;
+        case 6: kmc_mmvq_q8_0_launch<6>(args, vy, blocks_per_row_x, stride_row_x, stride_col_y, rows_per_block, stream); break;
+        case 7: kmc_mmvq_q8_0_launch<7>(args, vy, blocks_per_row_x, stride_row_x, stride_col_y, rows_per_block, stream); break;
+        case 8: kmc_mmvq_q8_0_launch<8>(args, vy, blocks_per_row_x, stride_row_x, stride_col_y, rows_per_block, stream); break;
+        default: GGML_ABORT("fatal error");
+    }
+}
