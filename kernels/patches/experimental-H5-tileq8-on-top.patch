+// KMC TILEQ8 (H5) dispatch: GTX 10x0 (cc 6.1) only, q8_0 K and V, head size 128, whole q8_0 blocks per row.
+// Valve: GGML_CUDA_DISABLE_KMC_TILEQ8 (any value) keeps the q8_0 -> f16 conversion path.
+static bool ggml_cuda_fattn_tile_q8_direct(const ggml_tensor * dst, const int cc) {
+    static const bool enabled = getenv("GGML_CUDA_DISABLE_KMC_TILEQ8") == nullptr;
+    const ggml_tensor * K = dst->src[1];
+    const ggml_tensor * V = dst->src[2];
+    return enabled && cc == 610 && K->type == GGML_TYPE_Q8_0 && V->type == GGML_TYPE_Q8_0 &&
+        K->ne[0] == 128 && V->ne[0] == 128 && K->nb[0] == sizeof(block_q8_0) && V->nb[0] == sizeof(block_q8_0) &&
+        K->nb[1] % sizeof(block_q8_0) == 0 && K->nb[2] % sizeof(block_q8_0) == 0 && K->nb[3] % sizeof(block_q8_0) == 0 &&
+        V->nb[1] % sizeof(block_q8_0) == 0 && V->nb[2] % sizeof(block_q8_0) == 0 && V->nb[3] % sizeof(block_q8_0) == 0;
+}
