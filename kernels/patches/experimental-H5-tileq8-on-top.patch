+// KMC TILEQ8 (H5): load q8_0 K/V rows straight into the FP32 SRAM tile, skipping the q8_0 -> f16 conversion buffer.
+// Every value is produced exactly as conversion + __half22float2 would produce it: float(half(float(q) * float(d))),
+// one round-to-nearest to f16 (convert.cu, generic q8_0 dequantization), so the tile and all math after it are bit-identical.
+// Work item = 8 values of one q8_0 block; q8_0 blocks are 34 bytes, so the quants are read as 16-bit words.
+template<int warp_size, int nwarps, int I, int J, int J_padding, bool oob_check>
+static __device__ __forceinline__ void flash_attn_tile_load_tile(
+        const block_q8_0 * const __restrict__ KV, float * const __restrict__ tile_KV, const int stride_KV, const int i_sup) {
+    static_assert(J % QK8_0 == 0, "bad J");
+    if constexpr (J == 0) {
+        return; // instantiated for an empty DKQ % nbatch_K remainder that never runs
+    } else {
+    constexpr int nsub   = QK8_0/8;
+    constexpr int nitems = I*(J/QK8_0)*nsub;
+    const int tid = threadIdx.y*warp_size + threadIdx.x;
+
+#pragma unroll
+    for (int n0 = 0; n0 < nitems; n0 += nwarps*warp_size) {
+        const int n = n0 + tid;
+        if (n0 + nwarps*warp_size > nitems && n >= nitems) {
+            break;
+        }
+        const int i  = n / ((J/QK8_0)*nsub);
+        const int jb = (n / nsub) % (J/QK8_0);
+        const int s  = n % nsub;
+
+        __align__(16) float tmp[8];
+        if (!oob_check || i < i_sup) {
+            const block_q8_0 * b = KV + int64_t(i)*stride_KV + jb;
+            const float d = __half2float(b->d);
+            const uint16_t * q16 = (const uint16_t *) (b->qs + 8*s);
+#pragma unroll
+            for (int l = 0; l < 4; ++l) {
+                const uint16_t v = q16[l];
+                tmp[2*l + 0] = __half2float(__float2half_rn(float((int8_t) (v & 0xFF)) * d));
+                tmp[2*l + 1] = __half2float(__float2half_rn(float((int8_t) (v >>   8)) * d));
+            }
+        } else {
+#pragma unroll
+            for (int l = 0; l < 8; ++l) {
+                tmp[l] = 0.0f;
+            }
+        }
+        // Pascal: max copy 8 bytes and the K tile rows are J + 2 floats long, so only 8-byte alignment is guaranteed
+        constexpr int cpy_nb = ggml_cuda_get_max_cpy_bytes();
+        float * dst = tile_KV + i*(J + J_padding) + jb*QK8_0 + 8*s;
+#pragma unroll
+        for (int l = 0; l < 8; l += cpy_nb/4) {
+            ggml_cuda_memcpy_1<cpy_nb>(dst + l, tmp + l);
+        }
+    }
+    }
+}
